# Dependências
node_modules/

# Banco de dados local (recriado automaticamente com dados de demonstração)
data/

# Bibliotecas e modelo de IA para uso offline (~67 MB) — gere com: npm run offline
public/vendor/

# Ambiente e logs
.env
.env.*
*.log
npm-debug.log*

# Sistema / editores
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/

# Ambientes virtuais Python (ex.: reciclaveis_yolo/.venv)
.venv/
__pycache__/

# Pesos de modelos YOLO e resultados de treino (arquivos grandes)
*.pt
runs/

# Cópias geradas pelos scripts do reciclaveis_yolo (as originais ficam em fotos/ e anotacoes/)
reciclaveis_yolo/dataset/
reciclaveis_yolo/fotos_para_anotar/
